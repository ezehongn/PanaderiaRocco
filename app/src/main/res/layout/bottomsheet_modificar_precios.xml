<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F8F2EA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TITULO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Modificar precios"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2D1B10"
            android:layout_marginBottom="24dp"/>

        <!-- BUSCADOR -->

        <AutoCompleteTextView
            android:id="@+id/editBuscarModificar"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Buscar producto o categoría"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="20dp"/>

        <!-- LISTA PRODUCTOS -->

        <LinearLayout
            android:id="@+id/layoutProductosSeleccionados"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#FFFFFF"
            android:padding="12dp"
            android:layout_marginBottom="24dp"/>

        <!-- RADIOGROUP -->

        <RadioGroup
            android:id="@+id/radioGroupOperacion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="20dp">

            <RadioButton
                android:id="@+id/radioAumento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Aumento"/>

            <RadioButton
                android:id="@+id/radioDescuento"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Descuento"
                android:layout_marginStart="24dp"/>

        </RadioGroup>

        <!-- PORCENTAJE -->

        <EditText
            android:id="@+id/editPorcentaje"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Porcentaje"
            android:inputType="numberDecimal"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="24dp"/>

        <!-- BOTONES -->

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btnCancelarCambios"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:text="Cancelar"
                android:textAllCaps="false"
                android:backgroundTint="#CFCFCF"
                android:textColor="#000000"/>

            <Button
                android:id="@+id/btnConfirmarCambios"
                android:layout_width="0dp"
                android:layout_height="60dp"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="Confirmar"
                android:textAllCaps="false"
                android:backgroundTint="#F2C95E"
                android:textColor="#2D1B10"/>

        </LinearLayout>

    </LinearLayout>

</ScrollView>