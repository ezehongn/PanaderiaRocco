<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#F8F2EA">

    <!-- TITULO -->

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Opciones productos"
        android:textSize="28sp"
        android:textStyle="bold"
        android:textColor="#2D1B10"
        android:layout_marginBottom="24dp"/>

    <!-- AGREGAR PRODUCTO -->

    <Button
        android:id="@+id/btnAgregarProducto"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Agregar producto"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#F2C95E"
        android:textColor="#2D1B10"/>

    <!-- ELIMINAR PRODUCTO -->

    <Button
        android:id="@+id/btnEliminarProducto"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:text="Eliminar producto"
        android:textAllCaps="false"
        android:textSize="18sp"
        android:textStyle="bold"
        android:backgroundTint="#D9534F"
        android:textColor="#FFFFFF"/>

    <!-- MODIFICAR PRODUCTO -->

    <Button
        android:id="@+id/btnModificarPrecios"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#00D4C2"
        android:text="Aplicar aumento / descuento"
        android:textAllCaps="false"
        android:textColor="#2D1B10"
        android:textSize="18sp"
        android:textStyle="bold" />

    <!-- CERRAR SESION -->

    <Button
        android:id="@+id/btnCerrarSesion"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:backgroundTint="#5F483C"
        android:text="Cerrar sesión"
        android:textAllCaps="false"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold" />

</LinearLayout>