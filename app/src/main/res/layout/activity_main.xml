<?xml version="1.0" encoding="utf-8"?>

<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="#F5F0E8">

    <!-- CONTENIDO -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"

        android:orientation="vertical">

        <!-- HEADER -->

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="115dp"

            android:background="#F7F1E7"

            android:padding="5dp"

            android:src="@drawable/logo_rocco"

            android:scaleType="centerInside"/>

        <!-- TABS -->

        <LinearLayout

            android:layout_width="match_parent"
            android:layout_height="80dp"

            android:background="#FFFDF9"

            android:elevation="2dp"

            android:orientation="horizontal">

            <!-- CUENTAS -->

            <LinearLayout
                android:id="@+id/tabCuentas"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                android:gravity="center"

                android:orientation="vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"

                    android:src="@drawable/ic_person"

                    app:tint="#2D1B10"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:text="CUENTAS"

                    android:textColor="#3A1F0F"

                    android:textSize="13sp"

                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- BUSQUEDA -->

            <LinearLayout
                android:id="@+id/tabBusqueda"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                android:background="#F3CD72"

                android:gravity="center"

                android:orientation="vertical">

                <ImageView
                    android:layout_width="30dp"
                    android:layout_height="30dp"

                    android:src="@drawable/ic_search"

                    app:tint="#2D1B10"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:text="BÚSQUEDA"

                    android:textColor="#3A1F0F"

                    android:textSize="13sp"

                    android:textStyle="bold"/>

            </LinearLayout>

            <!-- BALANCE -->

            <LinearLayout
                android:id="@+id/tabBalance"

                android:layout_width="0dp"
                android:layout_height="match_parent"

                android:layout_weight="1"

                android:gravity="center"

                android:orientation="vertical">

                <ImageView
                    android:layout_width="28dp"
                    android:layout_height="28dp"

                    android:src="@drawable/ic_chart"

                    app:tint="#2D1B10"/>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="4dp"

                    android:text="BALANCE"

                    android:textColor="#3A1F0F"

                    android:textSize="13sp"

                    android:textStyle="bold"/>

            </LinearLayout>

        </LinearLayout>

        <!-- FRAGMENT CONTAINER -->

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/fragmentContainer"

            android:layout_width="match_parent"

            android:layout_height="0dp"

            android:layout_weight="1"/>

    </LinearLayout>

    <!-- BOTON FLOTANTE -->



</RelativeLayout>