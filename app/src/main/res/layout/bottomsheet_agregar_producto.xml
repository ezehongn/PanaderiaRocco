<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F8F2EA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TITULO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Agregar producto"
            android:textColor="#2D1B10"
            android:textSize="28sp"
            android:textStyle="bold"
            android:layout_marginBottom="24dp"/>

        <!-- IMAGE SELECTOR -->

        <FrameLayout
            android:id="@+id/layoutSeleccionarImagen"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginBottom="24dp"
            android:background="#E7E7E7">

            <ImageView
                android:id="@+id/imagePreview"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"/>

            <TextView
                android:id="@+id/textSeleccionarImagen"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="Seleccionar imagen"
                android:textColor="#666666"
                android:textSize="18sp"
                android:textStyle="bold"/>

        </FrameLayout>

        <!-- NOMBRE -->

        <EditText
            android:id="@+id/editNombre"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:hint="Nombre del producto"
            android:padding="16dp"/>

        <!-- PRECIO -->

        <EditText
            android:id="@+id/editPrecio"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"
            android:hint="Precio"
            android:inputType="numberDecimal"
            android:padding="16dp"/>

        <!-- UNIDAD -->

        <Spinner
            android:id="@+id/spinnerUnidad"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="16dp"
            android:background="#FFFFFF"/>

        <!-- CATEGORIA -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Categorías"
            android:textColor="#2D1B10"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_marginBottom="10dp"/>

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupCategorias"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"/>

        <EditText
            android:id="@+id/editCategoria"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:layout_marginBottom="24dp"
            android:background="#FFFFFF"
            android:hint="Escribí una categoría y presioná Enter"
            android:padding="16dp"
            android:imeOptions="actionDone"
            android:inputType="text"/>

        <!-- BOTON -->

        <Button
            android:id="@+id/btnGuardarProducto"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Guardar producto"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#D69B1F"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</ScrollView>