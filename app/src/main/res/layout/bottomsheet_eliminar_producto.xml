<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#F8F2EA">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <!-- TITULO -->

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Eliminar producto"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#2D1B10"
            android:layout_marginBottom="24dp"/>

        <!-- BUSCADOR -->

        <AutoCompleteTextView
            android:id="@+id/editBuscarProducto"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:hint="Buscar producto"
            android:background="#FFFFFF"
            android:padding="16dp"
            android:layout_marginBottom="24dp"/>

        <!-- DATOS PRODUCTO -->

        <ImageView
            android:id="@+id/imageProductoEliminar"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:scaleType="centerCrop"
            android:background="#E7E7E7"/>

        <TextView
            android:id="@+id/textNombreEliminar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#2D1B10"
            android:gravity="center"
            android:paddingTop="18dp"/>

        <TextView
            android:id="@+id/textPrecioEliminar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="30sp"
            android:textStyle="bold"
            android:textColor="#D69B1F"
            android:gravity="center"
            android:paddingTop="8dp"
            android:paddingBottom="24dp"/>

        <!-- BOTON -->

        <Button
            android:id="@+id/btnConfirmarEliminar"
            android:layout_width="match_parent"
            android:layout_height="60dp"
            android:text="Eliminar producto"
            android:textAllCaps="false"
            android:textSize="18sp"
            android:textStyle="bold"
            android:backgroundTint="#D9534F"
            android:textColor="#FFFFFF"/>

    </LinearLayout>

</ScrollView>